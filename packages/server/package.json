{
  "name": "@sibeaver/server",
  "version": "0.2.0",
  "description": "AI-native cognitive engine — REST API, MCP, SIBS client",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "sibeaver": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "dev": "tsx watch src/api/server.ts",
    "build": "tsup",
    "test": "vitest run",
    "lint": "tsc --noEmit",
    "start": "tsx src/api/server.ts"
  },
  "keywords": [
    "ai-native",
    "project-management",
    "cognitive-graph",
    "mcp"
  ],
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.1",
    "@modelcontextprotocol/sdk": "^1.12.1",
    "@sibeaver/core": "workspace:*",
    "hono": "^4.12.28",
    "openai": "^6.39.0",
    "postgres": "^3.4.9",
    "ulidx": "^2.4.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.17",
    "tsup": "^8.4.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.1.3"
  }
}
